# AgriDoc AI Environment Configuration
# Copy to .env and fill in your values

# API Keys (comma-separated) - REQUIRED for production API
# Generate with: python -c "import secrets; print('agridoc-' + secrets.token_urlsafe(32))"
AGRIDOC_API_KEYS=agridoc-5mTNeyBhWqoFRKUQQJvIpgmo64jpGwushGKDTtBKmok

# Database encryption keys (Fernet) - REQUIRED, must be valid base64 Fernet keys
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AGRIDOC_DB_KEYS=88PzJhtJUBsfq9lYn4nv9GpRpe-QF9AqKP3215qaixg=
# CORS allowed origins - NEVER use "*" in production
CORS_ALLOWED_ORIGINS=https://agridoc-ai-frontend.onrender.com,http://localhost:3000

# Database URL (SQLite by default)
AGRIDOC_DATABASE_URL=sqlite:///./data/agridoc.db

# Model paths
AGRIDOC_MODEL_PATH=models/artifacts/agridoc_cv.onnx
AGRIDOC_CLASSES_PATH=data/splits/classes.json

# Knowledge base path
AGRIDOC_KB_PATH=data/knowledge/kb.json

# Translations path
AGRIDOC_TRANSLATIONS_PATH=data/translations/

# Queue TTL in hours (default 72)
AGRIDOC_QUEUE_TTL_HOURS=72

# Rate limit per minute per IP
AGRIDOC_RATE_LIMIT_PER_MIN=60

# Max image size in bytes (10 MiB)
AGRIDOC_MAX_IMAGE_BYTES=10485760

# Allowed image MIME types
AGRIDOC_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Frontend API URL (for Vite build)
VITE_BACKEND_URL=https://agridoc-backend.onrender.com/api

# Logging
AGRIDOC_LOG_LEVEL=INFO